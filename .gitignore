# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.eggs/

# ==========================================
# IDE
# ==========================================
.codegraph/
.reasonix/
.idea/
.vscode/
*.swp
*.swo

# ==========================================
# Dataset Images (large binary files)
# ==========================================
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png
dataset/**/*.bmp
dataset/**/*.webp
garbage_dataset/train/**/*
garbage_dataset/val/**/*
garbage_dataset/test/**/*
garbage_dataset/logs/

# Keep dataset structure but exclude images
!dataset/**/
!garbage_dataset/**/

# ==========================================
# Model Checkpoints & Binary Files (large)
# ==========================================
*.pt
*.pth
*.onnx
*.tflite
*.pb
outputs/**/*.pt
outputs/**/*.onnx
outputs/**/*.tflite
export/**/*.onnx
export/**/*.tflite
export/**/*.pb
export/**/saved_model/

# Keep export root-level model copies
!export/latest_*

# ==========================================
# Training Outputs (large/runtime artifacts)
# ==========================================
outputs/*/

# ==========================================
# Capture Screenshots
# ==========================================
Captures_Final/*
Captures_Locked_Trigger/*
Captures_Servo_Char/*
Captures_AI_Test/*

# ==========================================
# Logs
# ==========================================
Logs/*
*.log

# ==========================================
# CSV logs
# ==========================================
dataset/capture_log.csv
garbage_dataset/logs/
Garbage_Classification_Organized_before_rkho_full_load_fix/
