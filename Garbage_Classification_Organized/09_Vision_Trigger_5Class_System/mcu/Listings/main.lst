 197   3              }
 198   2              else if (raw == 0 && full_flag == 1) {
 199   3                  /* 从满载 → 恢复正常 */
 200   3                  full_flag = 0;
 201   3                  Uart_SendByte(MCU_NORMAL_CHAR);
 202   3              }
 203   2          }
 204   1      }
