             -�── */
  33          /* 直流电机驱动 (L298N / L9110S) */
  34          sbit MOTOR_EN  = P0^0;   /* 使能 */
  35          sbit MOTOR_IN1 = P0^1;   /* 方向 1 */
  36          sbit MOTOR_IN2 = P0^2;   /* 方向 2 */
  37          
  38          /* 舵机 PWM (软件 PWM 使用 Timer0 中断) */
  39          sbit SERVO = P1^5;
  40          
  41          /* 满载传感器 — 低电平触发（遮挡/满载时传感器输出低电平）
  42           * ⚠ P0 口开漏，必须外部上拉 4.7k~10kΩ 到 VCC */
  43          sbit FULL_L0 = P0^3;
  44          sbit FULL_L1 = P0^5;
  45          sbit FULL_L2 = P0^6;
  46          sbit FULL_L3 = P0^7;
  47          
