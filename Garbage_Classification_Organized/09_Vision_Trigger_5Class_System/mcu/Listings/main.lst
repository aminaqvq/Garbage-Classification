             -� */
  49          #define MCU_DONE_CHAR    'D'   /* 分拣完成 */
  50          #define MCU_FULL_CHAR    'F'   /* 满载暂停 */
  51          #define MCU_NORMAL_CHAR  'N'   /* 满载解除 */
